{
  "schema": "portable-skill-capabilities",
  "schema_version": "1.0.0",
  "skill": "product-seeding-studio",
  "target_platforms": [
    "codex",
    "generic"
  ],
  "capabilities": [
    {
      "id": "command.execute",
      "purpose": "运行已发现的 tbcli、xhscli 与本地输入校验器",
      "required": true,
      "required_features": [
        "argv-execution",
        "exit-status",
        "structured-output"
      ],
      "input_fields": [
        "argv"
      ],
      "output_fields": [
        "exitCode",
        "stdout"
      ],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "按本次创作意图及能力合同执行；付费生成遵循已授权方向与预算。"
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "FEATURE_UNSUPPORTED",
        "AUTH_REQUIRED",
        "OUTPUT_CONTRACT_FAILED"
      ]
    },
    {
      "id": "filesystem.artifacts",
      "purpose": "保存商品台账修订、原始主图、候选与独立回执",
      "required": true,
      "required_features": [
        "read-write",
        "exclusive-create",
        "public-image-download",
        "sha256",
        "exclusive-lock",
        "revision-conflict-detection"
      ],
      "input_fields": [
        "paths",
        "sourceUrls"
      ],
      "output_fields": [
        "localPaths",
        "hashes"
      ],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "按本次创作意图及能力合同执行；付费生成遵循已授权方向与预算。"
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "FEATURE_UNSUPPORTED",
        "AUTH_REQUIRED",
        "OUTPUT_CONTRACT_FAILED"
      ]
    },
    {
      "id": "media.image.inspect",
      "purpose": "查看商品参考与生成图片",
      "required": true,
      "required_features": [
        "local-image-view",
        "reference-comparison"
      ],
      "input_fields": [
        "imagePaths"
      ],
      "output_fields": [
        "observations",
        "qa"
      ],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "按本次创作意图及能力合同执行；付费生成遵循已授权方向与预算。"
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "FEATURE_UNSUPPORTED",
        "AUTH_REQUIRED",
        "OUTPUT_CONTRACT_FAILED"
      ]
    },
    {
      "id": "media.image.generate",
      "purpose": "从真实商品参考生成独立图片",
      "required": true,
      "required_features": [
        "reference-image-edit",
        "aspect-intent",
        "local-artifact-result"
      ],
      "input_fields": [
        "references",
        "prompt",
        "aspectRatio"
      ],
      "output_fields": [
        "artifacts",
        "metadata",
        "task_id"
      ],
      "side_effects": {
        "external_mutation": true,
        "may_cost_money": true,
        "authorization": "按本次创作意图及能力合同执行；付费生成遵循已授权方向与预算。"
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "FEATURE_UNSUPPORTED",
        "AUTH_REQUIRED",
        "OUTPUT_CONTRACT_FAILED"
      ]
    },
    {
      "id": "commerce.tbcli",
      "purpose": "通过买家入口只读采集公开商品摘要和主图来源",
      "required": true,
      "required_features": [
        "item-summary-v1"
      ],
      "input_fields": [
        "itemId"
      ],
      "output_fields": [
        "summary"
      ],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "仅按本次意图通过买家入口读取公开商品资料。"
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "FEATURE_UNSUPPORTED",
        "AUTH_REQUIRED",
        "OUTPUT_CONTRACT_FAILED"
      ]
    },
    {
      "id": "research.xhscli",
      "purpose": "在小红书研究节点搜索、导出笔记及评论，并归档图片、视频和可用Live素材",
      "required": false,
      "required_features": [
        "search-xlsx-v1",
        "note-json-v1",
        "completeness-status",
        "note-media-download-v1"
      ],
      "input_fields": [
        "keyword",
        "filters",
        "noteUrl",
        "outputPath"
      ],
      "output_fields": [
        "searchWorkbook",
        "noteJson",
        "complete",
        "failure",
        "mediaComplete",
        "mediaDirectory",
        "mediaFiles"
      ],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "小红书研究授权内只读平台内容并本地归档"
      },
      "errors": [
        "DEPENDENCY_MISSING",
        "CONTRACT_UNSUPPORTED",
        "LOGIN_REQUIRED",
        "VERIFICATION_REQUIRED",
        "OUTPUT_CONTRACT_FAILED"
      ]
    }
  ]
}
